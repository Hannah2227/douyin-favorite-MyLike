{
  "name": "mylike-desktop",
  "version": "2.0.1",
  "description": "MyLike Electron desktop application",
  "author": "MyLike contributors",
  "license": "MIT",
  "main": "out/main/index.cjs",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "icons": "node tools/build-icons.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests tools *.ts *.json *.yml",
    "format:check": "prettier --check src tests tools *.ts *.json *.yml",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "licenses:build": "node tools/licenses.mjs",
    "build": "pnpm typecheck && electron-vite build && pnpm licenses:build",
    "package:dir": "pnpm build && electron-builder --dir --win --x64 --publish never",
    "package:win": "pnpm build && electron-builder --win portable zip --x64 --publish never"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.21",
    "json-bigint": "1.0.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/json-bigint": "1.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
