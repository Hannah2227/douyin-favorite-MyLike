<Window x:Class="DouyinShuffle.Win.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyLike"
        Height="820" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">
    <!-- 无边框自绘标题栏:去系统标题栏,顶栏由 Web UI 承担(app-region:drag 拖动 + 自绘最小化/最大化/关闭) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="RootGrid">
        <!-- ★双 WebView 容器(账号"换舱"时控件 Dispose 重建,CoreWebView2 不能换环境必须重建控件):
             UiWebView(主界面)/ PlayerWebView(播放页)实例由 MainWindow.CreateWebView 注入,
             引用经 MainWindow.UiWebView/PlayerWebView 属性转发(全代码零改动)。
             两个 WebView 常驻可见,视图切换 = Win32 z-order 抬升/压底(见 ShowPlayer 注释)。 -->
        <Grid x:Name="WebViewHost"/>
    </Grid>
</Window>
